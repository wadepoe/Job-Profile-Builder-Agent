="false" sap:filterable="false" sap:label="We ask for your assistance.  We are an equal opportunity employer.  The following information is used to help us improve our recruiting programs.  Please be aware that you are not required to provide the requested information and any information you do provide will be treated confidentially.  If you choose not to provide this information, your decision will have no effect on the company’s employment decision.  Thank you for your help and cooperation."></Property><Property Name="instr_EEOlable" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Equal Employment Information"></Property><Property Name="instrubkgrndChkAttachment" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Reference Check"></Property><Property Name="interviewResult" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Interview Result"></Property><Property Name="jobCode" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Position Number "></Property><Property Name="jobRateOfPay" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Base Salary"></Property><Property Name="jobStartDate" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="fals