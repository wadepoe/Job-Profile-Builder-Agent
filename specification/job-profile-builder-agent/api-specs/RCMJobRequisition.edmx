n</Summary><LongDescription>Re-assign a job requisition</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Job Requisition</sap:tag></sap:tagcollection></Documentation><Parameter Name="jobReqId" Type="Edm.Int32"></Parameter><Parameter Name="hiringManager" Type="Edm.String"></Parameter><Parameter Name="recruiter" Type="Edm.String"></Parameter><Parameter Name="coordinator" Type="Edm.String"></Parameter><Parameter Name="vpOfStaffing" Type="Edm.String"></Parameter><Parameter Name="secondRecruiter" Type="Edm.String"></Parameter><Parameter Name="sourcer" Type="Edm.String"></Parameter></FunctionImport><FunctionImport Name="sendJobReqToPreviousStep" ReturnType="Edm.String" m:HttpMethod="GET" sap:support-payload="false"><Documentation><Summary>Send a job requisition to the previous step</Summary><LongDescription>Send a job requisition to the previous step, must be performed by the "Currently With" user.</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Job Requisition</sap:tag></sap:tagcollection></Documentation><Parameter Name="jobReqId" Type="Edm.Int64"></Parameter><Parameter Name="comment" Type="Edm.String"></Parameter></FunctionImport><FunctionImport Name="addModifierToJobReq" ReturnType="Edm.String" m:HttpMethod="GET" sap:support-payload="false"><Documentation><Summary>Add modifier to a job requisition</Summary><LongDescription>Add modifier to a job requisition</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Job Requisition</sap:tag></sap:tagcollection></Documentation><Parameter Name="jobReqId" Type="Edm.Int64"></Parameter><Parameter Name="modifier" Type="Edm.String"></Parameter></FunctionImport><FunctionImport Name="refreshInterviewAssessments" ReturnType="Edm.String" m:HttpMethod="POST" sap:support-payload="false"><Documentation><Summary>refresh Interview Assessments on updating Job Requisitions Competency</Summary><LongDescription>On adding competency to Job Requisition need to invoke refreshInterviewAssessments to update the InterviewIndividualAssessments of the Interviewers in corresponding Job Requisition.</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Job Requisition</sap:tag></sap:tagcollection></Documentation><Parameter Name="jobReqIdParam" Type="Edm.Int64"></Parameter></FunctionImport></EntityContainer></Schema><Schema Namespace="SFOData" xmlns="http://schemas.microsoft.com/ado/2008/09/edm" xmlns:sf="http://www.successfactors.com/edm/sf" xmlns:sap="http://www.successfactors.com/edm/sap"><EntityType Name="JobOfferTemplate_Standard_Offer_Details"><Key><PropertyRef Name="templateId"></PropertyRef></Key><Property Name="candJust" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Candidate Justification "></Property><Property Name="candidateName" Type="Edm.String" Nullable="false" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Candidate Full Name "></Property><Property Name="commission" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Commission"></Property><Property Name="currency" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Currency"></Property><Property Name="currentLocation" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Current Location"></Property><Property Name="department" Type="Edm.Strin